# Banco (no Neon: DATABASE_URL = host "-pooler", DIRECT_URL = host sem "-pooler")
DATABASE_URL="postgresql://smartlocker:smartlocker@localhost:5432/smartlocker"
DIRECT_URL="postgresql://smartlocker:smartlocker@localhost:5432/smartlocker"

# Sessão (mínimo de 32 caracteres)
NEXTAUTH_SECRET="troque-por-um-segredo-com-32-caracteres-ou-mais"
NEXTAUTH_URL="http://localhost:3000"

# Jobs agendados (Vercel Cron envia "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET="troque-por-um-segredo-aleatorio"

# Fechaduras IoT: token de cada armário = HMAC-SHA256(IOT_DEVICE_SECRET, armarioId)
IOT_DEVICE_SECRET="troque-por-um-segredo-aleatorio"

# Webhook PIX: header "x-webhook-assinatura" = HMAC-SHA256(PIX_WEBHOOK_SECRET, corpo)
PIX_WEBHOOK_SECRET="troque-por-um-segredo-aleatorio"

# Hash do PIN de acesso (opcional; se vazio usa NEXTAUTH_SECRET)
PIN_SECRET=""

# Broker MQTT (opcional; sem ele o /api/health informa "não configurado")
MQTT_BROKER_URL=""
